# Environment / secrets - NEVER commit these
.env
.env.local
.env.production.local

# Clips and generated video files
clips/
*.mp4
*.ts
*.m3u8
# ...except the tutorial's own media, which is a shipped site asset rather than
# a captured clip. Without this the walkthrough's videos are silently dropped
# from every commit, the .mp4 is missing on the server, and the page falls back
# to "video coming soon" placeholders that look exactly like unfinished work.
!src/dashboard/static/tutorial/*.mp4

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
*.egg-info/
dist/
build/

# Generated PDFs and utility scripts
*.pdf
generate_*.py

# Local tool config
.claude/

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# State backups (src/maintenance/backup.py)
backups/
