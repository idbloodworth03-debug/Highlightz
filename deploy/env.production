# ── Highlightz Production Config ──────────────────────────────────────────────
# Copy this file to /opt/highlightz/.env and fill in your values

# Twitch API (get from https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_OAUTH_TOKEN=your_twitch_oauth_token_here

# YouTube (optional - only needed if monitoring YouTube streams)
YOUTUBE_API_KEY=

# Redis (leave as-is, Redis runs locally on the server)
REDIS_URL=redis://localhost:6379/0

# Storage - clips saved on the server disk
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/opt/highlightz/clips

# FFmpeg and Streamlink - installed system-wide on Linux, no path needed
FFMPEG_PATH=ffmpeg
STREAMLINK_PATH=streamlink

# Dashboard login password - CHANGE THIS to something secure
DASHBOARD_PASSWORD=change_this_password

# Secret key for session cookies - generate a random string (keep this private)
# You can generate one by running: python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=change_this_to_a_random_secret_key

# Clip settings
BUFFER_DURATION_SECONDS=300
CLIP_PRE_ROLL_SECONDS=45
CLIP_POST_ROLL_SECONDS=15

# Logging
LOG_LEVEL=INFO
