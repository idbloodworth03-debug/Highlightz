# Hardened unit: runs as the unprivileged `highlightz` user with a read-only
# filesystem view (only clips/ is writable). To migrate a server currently
# running the service as root, run (as root):
#
#   id highlightz 2>/dev/null || useradd --system --home /opt/highlightz --shell /usr/sbin/nologin highlightz
#   chown -R highlightz:highlightz /opt/highlightz/clips
#   chgrp highlightz /opt/highlightz/.env && chmod 640 /opt/highlightz/.env
#   cp /opt/highlightz/deploy/highlightz.service /etc/systemd/system/highlightz.service
#   systemctl daemon-reload && systemctl restart highlightz
#   systemctl status highlightz --no-pager | head -12
#
# Notes: .env MUST be group-readable by the service user (640 root:highlightz)
# — systemd reads EnvironmentFile as root, but pydantic-settings ALSO opens
# .env directly from the process, which crash-loops on a 600 root:root file.
# Code stays root-owned (the service only reads it, so root-driven `git reset`
# deploys keep working); the backup cron keeps running as root and writes
# /opt/highlightz/backups, outside this sandbox.
[Unit]
Description=Highlightz Stream Clipping Bot
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=highlightz
Group=highlightz
WorkingDirectory=/opt/highlightz
ExecStart=/opt/highlightz/venv/bin/python -m src.main
Restart=always
RestartSec=10
# The default soft limit (1024) is what froze the site on 2026-10-29: Kick
# chat webhooks piled up past it and accept() failed with EMFILE. The app
# raises its own soft limit at startup too (src/main.py), so a server whose
# installed unit predates this line is covered by the next deploy.
LimitNOFILE=65536
EnvironmentFile=/opt/highlightz/.env

# Give FFmpeg enough time to buffer on shutdown
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=highlightz

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/highlightz/clips

[Install]
WantedBy=multi-user.target
