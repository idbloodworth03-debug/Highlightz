# ── Twitch ──────────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_OAUTH_TOKEN=your_twitch_oauth_token

# ── YouTube ──────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key

# ── Kick (monitoring + sign-in) ──────────────────────────
# One Kick developer app (kick.com → Settings → Developer) does both jobs:
# its client credentials mint an APP token for the public API (liveness,
# title, viewers; blank = fall back to kick.com's site endpoint), and the
# same id/secret power "Continue with Kick" on the sign-in page, which only
# appears once both are set. Register this redirect URL on the app:
#   <PUBLIC_BASE_URL>/auth/kick/callback
# Sign-in keeps the Kick user id, name and avatar only; the token is not stored.
# Kick clips are files cut from live capture: CLIP_CAPTURE_ENABLED must be true.
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_REDIRECT_URI=https://highlightz.app/auth/kick/callback

# ── Autopilot (Pro; approve → server render → queued post) ─
# drawtext needs a real TTF for titles/captions; DejaVu ships with Ubuntu.
# AUTOPILOT_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# AUTOPILOT_RENDER_TIMEOUT_S=300

# ── Posting (the Scheduler posts to connected accounts) ─
# Register each app once; blank = that platform shows "Coming soon".
# Redirect URIs to register: <PUBLIC_BASE_URL>/publish/connect/<platform>/callback
# PUBLIC_BASE_URL=https://highlightz.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://superclip:password@localhost:5432/superclipbot

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────
STORAGE_BACKEND=s3              # s3 | gcs | local
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
S3_BUCKET=superclipbot-clips

GCS_PROJECT_ID=your_project
GCS_BUCKET=superclipbot-clips

LOCAL_STORAGE_PATH=./clips

# ── App ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# Bind address: 127.0.0.1 (default) keeps the app reachable only through the
# nginx proxy. Set to 0.0.0.0 only if the process must accept direct external
# connections (e.g. Docker port mapping).
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change_me_in_production
BUFFER_DURATION_SECONDS=90
CLIP_PRE_ROLL_SECONDS=30
CLIP_POST_ROLL_SECONDS=10
MAX_CONCURRENT_STREAMS=20
