# ── Twitch ──────────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_OAUTH_TOKEN=your_twitch_oauth_token

# ── YouTube ──────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://superclip:password@localhost:5432/superclipbot

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────
STORAGE_BACKEND=s3              # s3 | gcs | local
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
S3_BUCKET=superclipbot-clips

GCS_PROJECT_ID=your_project
GCS_BUCKET=superclipbot-clips

LOCAL_STORAGE_PATH=./clips

# ── App ──────────────────────────────────────────────────
LOG_LEVEL=INFO
DASHBOARD_SECRET_KEY=change_me_in_production
BUFFER_DURATION_SECONDS=90
CLIP_PRE_ROLL_SECONDS=30
CLIP_POST_ROLL_SECONDS=10
MAX_CONCURRENT_STREAMS=20
